# Shared password to view the dashboard (pick anything, keep it private)
DASHBOARD_PASSWORD=

# Notion — create an integration at https://www.notion.so/my-integrations,
# then share the Client Work Board database with it ("..." menu > Connections),
# then paste the integration's secret token here.
NOTION_TOKEN=
NOTION_CLIENT_BOARD_DB_ID=323c1adacbe780648916df44ef5a8465
NOTION_CLIENT_TASKS_DB_ID=9a654c5b105647bcb8451a4abc0a8d94

# QuickFile — generate a personal API token under
# Account Settings > Third Party Integration > API, granting read access
# to Banks and Invoices. Paste it here (no "Bearer" prefix needed).
QUICKFILE_API_TOKEN=
QUICKFILE_API_BASE=https://api-beta.quickfile.co.uk

# Weather — defaults to the Oswestry/Gobowen area. Override if you want
# weather for somewhere else (find coordinates at latlong.net).
WEATHER_LAT=52.87
WEATHER_LON=-3.05

# Link to the Gobowen/Maple Class weekly page you already built and shared
NEXT_SCHOOL_PAGE_URL=
